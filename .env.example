# Copy to .env (gitignored) in the repo root. `docker compose` reads .env automatically
# for the ${...} values in docker-compose.yml and docker-compose.prod.yml.

# Signs login tokens. Required by docker-compose.prod.yml. Generate a long random value;
# changing it logs everyone out.
# e.g. openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Postgres login for docker-compose.prod.yml. The dev compose file always uses orderflow/orderflow.
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
