# GitHub repository variables for the AWS workflows: a checklist, not a file the app reads.
#
# Quickest: copy to github-variables.env (gitignored), fill it in, then run
#   gh variable set -f infra/aws/github-variables.env --repo manimaran98/order-flow
#
# Or by hand: GitHub repo -> Settings -> Secrets and variables -> Actions -> Variables tab
#                -> "New repository variable", one per line below (name = left of "=").
# Use Variables, not Secrets: the workflows read them as vars.NAME. None of these values are secret.
# Replace <AWS_ACCOUNT_ID> with your 12-digit account ID (AWS Console, top-right menu).


# ---------------------------------------------------------------------------
# Step 1: set these two before the first Terraform run
# ---------------------------------------------------------------------------

# The IAM role you created by hand that GitHub uses to run Terraform (IAM -> Roles -> terraform-deployer -> ARN).
# Used by: .github/workflows/terraform.yml. Without it the Terraform workflow is skipped.
AWS_TERRAFORM_ROLE_ARN=arn:aws:iam::<AWS_ACCOUNT_ID>:role/terraform-deployer

# Region for everything. Singapore, the closest region to Malaysia without an opt-in.
# Used by: terraform.yml and deploy.yml.
AWS_REGION=ap-southeast-1


# ---------------------------------------------------------------------------
# Step 2: run Actions -> Terraform -> Run workflow -> apply, then set these three.
# The run's Summary page prints the exact values under
# "Repository variables for the Deploy workflow".
# ---------------------------------------------------------------------------

# The narrow deploy role Terraform creates (push images, run migrations, update the services).
# The name is fixed, so only the account ID changes.
# Used by: .github/workflows/deploy.yml. Without it the Deploy workflow is skipped.
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::<AWS_ACCOUNT_ID>:role/orderflow-github-deploy

# The two public subnets the one-off migration task runs in. Both IDs, comma-separated, no space.
# If the summary isn't available: AWS Console (Singapore) -> VPC -> Subnets ->
# rows "orderflow-public-0" and "orderflow-public-1".
# Used by: deploy.yml, "Run database migrations" step (it fails without it).
MIGRATE_SUBNETS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy

# Security group for the migration task (the backend's group, which is allowed to reach RDS).
# If the summary isn't available: AWS Console (Singapore) -> VPC -> Security groups -> row "orderflow-backend".
# Used by: deploy.yml, "Run database migrations" step.
MIGRATE_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx

# Step 3: run Actions -> Deploy -> Run workflow on main. From then on, every merge to main deploys itself.


# ---------------------------------------------------------------------------
# Optional: HTTPS, only once you own a domain. Leave these unset until then.
# Full steps: infra/aws/README.md, "Adding HTTPS".
# ---------------------------------------------------------------------------

# The hostname to serve on: lowercase, no https://. Setting it requests a free ACM certificate
# and prints the DNS records to add at your registrar in the Terraform run summary.
# DOMAIN_NAME=app.example.com

# Only set this after the certificate shows ISSUED. Lowercase true or false.
# HTTPS_ENABLED=true

# Only if the domain's DNS is in Route 53: Terraform then creates the DNS records for you.
# Route 53 -> Hosted zones -> your domain -> Hosted zone ID.
# ROUTE53_ZONE_ID=Z0123456789ABCDEFGHIJ
